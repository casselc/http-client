{:paths ["src"]

 ;; clj-http-lite straight from its git repo. Jolt ignores the org.clojure/clojure
 ;; dependency it declares; this library supplies the JVM host APIs clj-http-lite
 ;; needs (HttpURLConnection / URL / java.util.zip / javax.net.ssl) as Jolt host
 ;; shims, plus TCP through jolt-tcp, TLS through OpenSSL memory BIOs, and gzip
 ;; through libz.
 ;; clj-http-lite straight from git. jolt-tcp brings the portable socket stack
 ;; (jolt-tcp -> jolt-net), whose only native declarations are the process image
 ;; and an :optional ws2_32; jolt-crypto contributes libcrypto/bcrypt, both
 ;; :optional, and deliberately does NOT own libssl. That leaves the plaintext
 ;; graph free of any required shared object, which is what lets it start on
 ;; native Windows.
 :deps {org.clj-commons/clj-http-lite
        {:git/url "https://github.com/clj-commons/clj-http-lite"
         :git/sha "5bc2a98969b4926d090787baf9297fd73cea42d0"}
        io.github.casselc/jolt-tcp
        {:git/url "https://github.com/casselc/jolt-tcp.git"
         :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
        io.github.casselc/jolt-crypto
        {:git/url "https://github.com/casselc/jolt-crypto.git"
         :git/sha "c0b8237e74e4f17d2675b57bab32d4aebd92812f"}}

 ;; Capability libraries, not requirements. Both are :optional so a missing
 ;; libssl or libz is a runtime capability gap reported by jolt.http.capability
 ;; as a structured unsupported-provider error — never a load-time abort of the
 ;; plaintext graph. libssl is declared here because jolt-crypto owns libcrypto
 ;; only; TLS consumers declare libssl themselves.
 :jolt/native [{:name "z"
                :optional true
                :darwin ["libz.dylib" "/usr/lib/libz.dylib"]
                :linux  ["libz.so.1" "libz.so"]}
               {:name "ssl"
                :optional true
                :darwin ["/opt/homebrew/opt/openssl@3/lib/libssl.dylib"
                         "/opt/homebrew/lib/libssl.dylib"
                         "/usr/local/opt/openssl@3/lib/libssl.dylib"
                         "/usr/lib/libssl.dylib" "libssl.dylib"]
                :linux  ["libssl.so.3" "libssl.so.1.1" "libssl.so"]}]

 ;; Tests run clj-http-lite's own client/links/integration suites under Jolt, with
 ;; in-process plaintext + TLS servers in place of the suite's Jetty subprocess.
 :aliases {:test {:extra-paths ["test"]
                  :main-opts ["-m" "jolt.http.test-runner"]}
           ;; The cross-platform plaintext gate. It declares no :extra-deps and
           ;; loads no TLS or compression namespace, so the coverage it reports
           ;; cannot quietly become POSIX coverage: if anything dragged libssl
           ;; or libz back into the plaintext graph, this lane is what stops
           ;; starting on a machine that has neither.
           :plaintext-test {:extra-paths ["test"]
                            :main-opts ["-m" "jolt.http.plaintext-test"]}
           ;; Reports which optional capabilities resolved on this platform.
           :capability {:extra-paths ["test"]
                        :main-opts ["-m" "jolt.http.capability-test"]}
           ;; Portable Schannel buffer/ownership contracts. The namespace's FFI
           ;; bindings are lazy, so this runs on POSIX without Secur32.dll; the
           ;; dedicated Windows gate adds the real ABI and loopback handshake.
           :schannel-contract-test
           {:extra-paths ["test"]
            :main-opts ["-m" "jolt.http.schannel-test"]}
           :schannel-runtime-test
           {:extra-paths ["test"]
            :main-opts ["-m" "jolt.http.schannel-runtime-test"]}
           ;; isolated zlib round-trip check (no clj-http-lite / sockets needed)
           :zlibtest {:extra-paths ["test"]
                      :main-opts ["-m" "jolt.http.zlib-test"]}
           ;; babashka.http-client compat: it runs on jolt over jolt.http.platform's
           ;; java.net.http shim. Plaintext in-process server, so no TLS/crypto.
           :bhctest {:extra-paths ["test"]
                     :extra-deps {org.babashka/http-client {:mvn/version "0.4.23"}}
                     :main-opts ["-m" "jolt.http.babashka-test"]}}

 :tasks {test "joltc -M:test"}}
