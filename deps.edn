{:paths ["src"]

 ;; clj-http-lite straight from its git repo. Jolt ignores the org.clojure/clojure
 ;; dependency it declares; this library supplies the JVM host APIs clj-http-lite
 ;; needs (HttpURLConnection / URL / java.util.zip / javax.net.ssl) as Jolt host
 ;; shims, plus TCP through jolt-tcp, TLS through OpenSSL memory BIOs, and gzip
 ;; through libz.
 ;; clj-http-lite straight from git; jolt-lang/jolt-crypto carries the OpenSSL
 ;; (libssl/libcrypto) declarations + the java.security.SecureRandom shim TLS
 ;; needs — so this library and the ring adapter don't each redeclare them
 ;; (jolt.deps reconciles to one load).
 :deps {org.clj-commons/clj-http-lite
        {:git/url "https://github.com/clj-commons/clj-http-lite"
         :git/sha "5bc2a98969b4926d090787baf9297fd73cea42d0"}
        io.github.casselc/jolt-tcp
        {:git/url "https://github.com/casselc/jolt-tcp.git"
         :git/sha "0c3e085f43b90b346be9843e43448c890f8b701d"}
        jolt-lang/jolt-crypto {:git/url "https://github.com/jolt-lang/jolt-crypto"
                               :git/sha "8a3247f698fbd462cddae9b206a7e3b3aac1bb92"}}

 ;; jolt-tcp owns the transitive platform socket declarations. libssl/libcrypto
 ;; come from jolt-crypto; this project declares only libz directly.
 :jolt/native [{:name "z"
                :darwin ["libz.dylib" "/usr/lib/libz.dylib"]
                :linux  ["libz.so.1" "libz.so"]}]

 ;; Tests run clj-http-lite's own client/links/integration suites under Jolt, with
 ;; in-process plaintext + TLS servers in place of the suite's Jetty subprocess.
 :aliases {:test {:extra-paths ["test"]
                  :main-opts ["-m" "jolt.http.test-runner"]}
           ;; Exercise the locally migrated dependency chain before its new
           ;; jolt-net/jolt-tcp commits have published Git SHAs.
           :workspace
           {:override-deps {io.github.casselc/jolt-tcp
                            {:local/root "../jolt-tcp"}
                            io.github.casselc/jolt-net
                            {:local/root "../jolt-net"}}}
           ;; https read-timeout + OpenSSL symbol-pinning regressions. Separate
           ;; process: they stall a connection on purpose and stand up their own
           ;; servers, which the main suite's serial accept loop doesn't tolerate.
           :timeouttest {:extra-paths ["test"]
                         :main-opts ["-m" "jolt.http.timeout-runner"]}
           ;; isolated zlib round-trip check (no clj-http-lite / sockets needed)
           :zlibtest {:extra-paths ["test"]
                      :main-opts ["-m" "jolt.http.zlib-test"]}
           ;; babashka.http-client compat: it runs on jolt over jolt.http.platform's
           ;; java.net.http shim. Plaintext in-process server, so no TLS/crypto.
           :bhctest {:extra-paths ["test"]
                     :extra-deps {org.babashka/http-client {:mvn/version "0.4.23"}}
                     :main-opts ["-m" "jolt.http.babashka-test"]}}

 :tasks {test "jolt -A:workspace -M:test"
         timeouttest "jolt -A:workspace -M:timeouttest"}}
