{:material "2585:{:paths [\"src\"]\n\n ;; clj-http-lite straight from its git repo. Jolt ignores the org.clojure/clojure\n ;; dependency it declares; this library supplies the JVM host APIs clj-http-lite\n ;; needs (HttpURLConnection / URL / java.util.zip / javax.net.ssl) as Jolt host\n ;; shims, plus TLS (OpenSSL) and gzip (libz) through jolt.ffi.\n ;; clj-http-lite straight from git; jolt-lang/jolt-crypto carries the OpenSSL\n ;; (libssl/libcrypto) declarations + the java.security.SecureRandom shim TLS\n ;; needs — so this library and the ring adapter don't each redeclare them\n ;; (jolt.deps reconciles to one load).\n :deps {org.clj-commons/clj-http-lite\n        {:git/url \"https://github.com/clj-commons/clj-http-lite\"\n         :git/sha \"5bc2a98969b4926d090787baf9297fd73cea42d0\"}\n        jolt-lang/jolt-crypto {:git/url \"https://github.com/jolt-lang/jolt-crypto\"\n                               :git/sha \"0adae49db6064180374ffdcfc72b5b9ac01888cd\"}}\n\n ;; libc (BSD sockets, the running process's symbols) and libz (gzip); libssl/\n ;; libcrypto come from jolt-crypto, loaded before these namespaces so the\n ;; foreign-fn bindings in jolt.http.tls resolve.\n :jolt/native [{:name \"libc (POSIX sockets)\" :process true}\n               {:name \"z\"\n                :darwin [\"libz.dylib\" \"/usr/lib/libz.dylib\"]\n                :linux  [\"libz.so.1\" \"libz.so\"]}]\n\n ;; Tests run clj-http-lite's own client/links/integration suites under Jolt, with\n ;; in-process plaintext + TLS servers in place of the suite's Jetty subprocess.\n :aliases {:test {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"jolt.http.test-runner\"]}\n           ;; https read-timeout + OpenSSL symbol-pinning regressions. Separate\n           ;; process: they stall a connection on purpose and stand up their own\n           ;; servers, which the main suite's serial accept loop doesn't tolerate.\n           :timeouttest {:extra-paths [\"test\"]\n                         :main-opts [\"-m\" \"jolt.http.timeout-runner\"]}\n           ;; isolated zlib round-trip check (no clj-http-lite / sockets needed)\n           :zlibtest {:extra-paths [\"test\"]\n                      :main-opts [\"-m\" \"jolt.http.zlib-test\"]}\n           ;; babashka.http-client compat: it runs on jolt over jolt.http.platform's\n           ;; java.net.http shim. Plaintext in-process server, so no TLS/crypto.\n           :bhctest {:extra-paths [\"test\"]\n                     :extra-deps {org.babashka/http-client {:mvn/version \"0.4.23\"}}\n                     :main-opts [\"-m\" \"jolt.http.babashka-test\"]}}\n\n :tasks {test \"jolt -M:test\"\n         timeouttest \"jolt -M:timeouttest\"}}\n|679:{:aliases {;; Add cross-project aliases here\n           :outdated {;; Note that it is `:deps`, not `:extra-deps`\n                      :deps {com.github.liquidz/antq {:mvn/version \"2.5.1109\"}}\n                      :main-opts [\"-m\" \"antq.core\"]}\n           :mcp\n           {:deps {org.slf4j/slf4j-nop {:mvn/version \"2.0.16\"} ;; Required for stdio server\n                   com.bhauman/clojure-mcp {:git/url \"https://github.com/bhauman/clojure-mcp.git\"\n                                            :git/tag \"v0.1.6-alpha\"\n                                            :git/sha \"4ad62f4\"}}\n            :exec-fn clojure-mcp.main/start-mcp-server\n            :exec-args {:port 7888}}}}\n|[]|v0.7.17-14-gf409ecd6-dirty|/Users/yogthos/.jolt/gitlibs|||||/Users/yogthos|", :value {:roots ["/Users/yogthos/.jolt/gitlibs/https___github.com_clj-commons_clj-http-lite/5bc2a98969b4926d090787baf9297fd73cea42d0/src" "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_jolt-crypto/0adae49db6064180374ffdcfc72b5b9ac01888cd/src"], :natives [{:name "crypto", :darwin ["/opt/homebrew/opt/openssl@3/lib/libcrypto.dylib" "/usr/lib/libcrypto.dylib" "libcrypto.dylib"], :linux ["libcrypto.so.3" "libcrypto.so.1.1" "libcrypto.so"]} {:name "ssl", :darwin ["/opt/homebrew/opt/openssl@3/lib/libssl.dylib" "/usr/lib/libssl.dylib" "libssl.dylib"], :linux ["libssl.so.3" "libssl.so.1.1" "libssl.so"]}], :prep [], :libs {org.clj-commons/clj-http-lite #:git{:url "https://github.com/clj-commons/clj-http-lite", :sha "5bc2a98969b4926d090787baf9297fd73cea42d0"}, jolt-lang/jolt-crypto #:git{:url "https://github.com/jolt-lang/jolt-crypto", :sha "0adae49db6064180374ffdcfc72b5b9ac01888cd"}}, :trace nil}}