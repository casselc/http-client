; Bounded claim: one non-empty Schannel-allocated output token is sent, freed,
; and cleared before the outer cleanup inspects its descriptor. Expected:
; unsat for leak, double-free, duplicate send, or post-release send.

(set-option :produce-unsat-cores true)

(declare-const send_step Int)
(declare-const inner_free_step Int)
(declare-const clear_step Int)
(declare-const outer_cleanup_step Int)
(declare-const outer_sees_live_pointer Bool)
(declare-const send_count Int)
(declare-const inner_free_count Int)
(declare-const outer_free_count Int)
(declare-const total_free_count Int)
(declare-const leaked Bool)
(declare-const double_freed Bool)
(declare-const send_after_release Bool)
(declare-const violation Bool)

(assert (! (and (<= 0 send_step) (<= send_step 3)
                (<= 0 inner_free_step) (<= inner_free_step 3)
                (<= 0 clear_step) (<= clear_step 3)
                (<= 0 outer_cleanup_step) (<= outer_cleanup_step 3)
                (distinct send_step inner_free_step clear_step outer_cleanup_step))
           :named four_distinct_bounded_steps))
(assert (! (< send_step inner_free_step) :named send_precedes_inner_free))
(assert (! (< inner_free_step clear_step)
           :named inner_free_precedes_descriptor_clear))
(assert (! (< clear_step outer_cleanup_step)
           :named descriptor_clear_precedes_outer_cleanup))
(assert (! (= outer_sees_live_pointer (< outer_cleanup_step clear_step))
           :named outer_observes_descriptor_state))
(assert (! (= send_count 1) :named nonempty_token_sent_once))
(assert (! (= inner_free_count 1) :named inner_finally_frees_once))
(assert (! (= outer_free_count (ite outer_sees_live_pointer 1 0))
           :named outer_frees_iff_pointer_is_live))
(assert (! (= total_free_count (+ inner_free_count outer_free_count))
           :named total_free_count_definition))
(assert (! (= leaked (= total_free_count 0)) :named leak_definition))
(assert (! (= double_freed (> total_free_count 1)) :named double_free_definition))
(assert (! (= send_after_release (> send_step inner_free_step))
           :named post_release_send_definition))
(assert (! (= violation
              (or (distinct send_count 1) leaked double_freed send_after_release))
           :named ownership_violation_definition))
(assert (! violation :named property_violated))

(check-sat)
(get-unsat-core)
