; Concrete useful trace for the corrected suffix model. Expected: sat with
; [10 11 12 13], extra length 2, next input [12 13].

(set-option :produce-unsat-cores true)

(declare-const input_length Int)
(declare-const extra_length Int)
(declare-const copy_start Int)
(declare-const carry_length Int)
(declare-const next_length Int)
(declare-const input (Array Int Int))
(declare-const carry (Array Int Int))
(declare-const next_input (Array Int Int))

(assert (! (= input_length 4) :named four_byte_input))
(assert (! (= extra_length 2) :named two_byte_extra))
(assert (! (= copy_start (- input_length extra_length))
           :named tail_copy_starts_at_n_minus_extra))
(assert (! (= carry_length extra_length) :named carry_length_is_extra_length))
(assert (! (= next_length carry_length) :named next_input_length_is_carry_length))
(assert (! (= (select input 0) 10) :named input_byte_0))
(assert (! (= (select input 1) 11) :named input_byte_1))
(assert (! (= (select input 2) 12) :named input_byte_2))
(assert (! (= (select input 3) 13) :named input_byte_3))
(assert (! (= (select carry 0) (select input copy_start))
           :named copied_suffix_byte_0))
(assert (! (= (select carry 1) (select input (+ copy_start 1)))
           :named copied_suffix_byte_1))
(assert (! (= (select next_input 0) (select carry 0))
           :named next_input_byte_0))
(assert (! (= (select next_input 1) (select carry 1))
           :named next_input_byte_1))
(assert (! (and (= next_length 2)
                (= (select next_input 0) 12)
                (= (select next_input 1) 13))
           :named ordered_suffix_is_reachable))

(check-sat)
(get-model)
